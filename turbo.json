{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "NEXT_PUBLIC_SUPABASE_URL",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY",
    "NEXT_PUBLIC_PRIVY_APP_ID",
    "NEXT_PUBLIC_CORE_API_URL",
    "NEXT_PUBLIC_API_URL",
    "NEXT_PUBLIC_CANTON_LEDGER_URL",
    "NEXT_PUBLIC_CANTON_DAML_PACKAGE_ID",
    "NEXT_PUBLIC_USDC_CONTRACT_ID",
    "NEXT_PUBLIC_CANTON_ADMIN_PARTY_ID",
    "NEXT_PUBLIC_CANTON_TEMPLATE_PROPERTY_POOL",
    "NEXT_PUBLIC_CANTON_TEMPLATE_USDC_ASSET",
    "NEXT_PUBLIC_PLEDGE_META_URI_BASE",
    "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
    "NEXT_PUBLIC_CANTON_WC_CHAIN_ID",
    "NEXT_PUBLIC_CANTON_NETWORK_ID",
    "VERCEL",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "NEXT_PUBLIC_SUPABASE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_PRIVY_APP_ID",
        "NEXT_PUBLIC_CORE_API_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_CANTON_LEDGER_URL",
        "NEXT_PUBLIC_CANTON_DAML_PACKAGE_ID",
        "NEXT_PUBLIC_USDC_CONTRACT_ID",
        "NEXT_PUBLIC_CANTON_ADMIN_PARTY_ID",
        "NEXT_PUBLIC_CANTON_TEMPLATE_PROPERTY_POOL",
        "NEXT_PUBLIC_CANTON_TEMPLATE_USDC_ASSET",
        "NEXT_PUBLIC_PLEDGE_META_URI_BASE",
        "NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID",
        "NEXT_PUBLIC_CANTON_WC_CHAIN_ID",
        "NEXT_PUBLIC_CANTON_NETWORK_ID"
      ]
    },
    "@rentyvest/ledger-client#build": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
